{{!
    @template mod_securevideo/player

    Encrypted HLS video player with dynamic canvas watermark, interactive questions, and custom controls.
}}
<div class="mod-securevideo-wrapper my-3">
    <div id="secureVideoContainer"
         class="securevideo-player-container position-relative bg-black rounded shadow-lg overflow-hidden user-select-none"
         tabindex="0"
         data-cmid="{{cmid}}"
         data-playlisturl="{{playlisturl}}"
         data-duration="{{duration}}"
         data-lastposition="{{lastposition}}"
         data-maxposition="{{maxposition}}"
         data-watchedseconds="{{watchedseconds}}"
         data-watchedintervals="{{watchedintervals}}"
         data-percentcompleted="{{percentcompleted}}"
         data-completionminpercent="{{completionminpercent}}"
         data-preventseeking="{{#preventseeking}}1{{/preventseeking}}{{^preventseeking}}0{{/preventseeking}}"
         data-watermarkenabled="{{#watermarkenabled}}1{{/watermarkenabled}}{{^watermarkenabled}}0{{/watermarkenabled}}"
         data-watermarkopacity="{{watermarkopacity}}"
         data-studentname="{{studentname}}"
         data-studentid="{{studentid}}"
         data-studentip="{{studentip}}"
         data-livetime="{{livetime}}"
         data-questions="{{questionsjson}}">

        {{! Native video element (Blob via MSE) }}
        <div class="ratio ratio-16x9 position-relative bg-black">
            <video id="secureVideoElement"
                   class="w-100 h-100"
                   playsinline
                   preload="auto"
                   poster="{{thumbnailurl}}"
                   controlslist="nodownload noplaybackrate"
                   disablepictureinpicture="true"
                   oncontextmenu="return false;">
            </video>

            {{! Dynamic moving canvas watermark overlay - floats over video & question overlay }}
            {{#watermarkenabled}}
            <canvas id="secureVideoWatermarkCanvas"
                    class="securevideo-watermark-canvas position-absolute top-0 start-0 w-100 h-100"
                    style="pointer-events: none; z-index: 50;">
            </canvas>
            {{/watermarkenabled}}

            {{! Center big play/pause button overlay }}
            <div class="securevideo-center-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center cursor-pointer"
                 style="z-index: 10;">
                <button type="button" class="btn btn-dark bg-opacity-50 text-white rounded-circle p-3 securevideo-btn-bigplay" aria-label="{{#str}}play, mod_securevideo{{/str}}">
                    <i class="fa fa-play fa-2x" aria-hidden="true"></i>
                </button>
            </div>

            {{! Resume Playback Toast }}
            {{#hasresume}}
            <div id="secureVideoResumeToast"
                 class="securevideo-resume-toast position-absolute top-0 start-50 translate-middle-x mt-3 bg-dark bg-opacity-90 text-white px-3 py-2 rounded shadow d-flex align-items-center gap-2 border border-secondary"
                 style="z-index: 25;">
                <i class="fa fa-history text-info" aria-hidden="true"></i>
                <span class="small">{{#str}}resumeprompt, mod_securevideo, {{lastposformatted}}{{/str}}</span>
                <button type="button" class="btn btn-sm btn-primary py-0 px-2 btn-action-resume">{{#str}}resume, mod_securevideo{{/str}}</button>
                <button type="button" class="btn btn-sm btn-outline-light py-0 px-2 btn-action-dismiss">{{#str}}startover, mod_securevideo{{/str}}</button>
            </div>
            {{/hasresume}}

            {{! Seeking locked notification }}
            <div id="secureVideoSeekNotice"
                 class="securevideo-seek-notice position-absolute top-50 start-50 translate-middle bg-dark bg-opacity-90 text-white px-3 py-2 rounded shadow d-none"
                 style="z-index: 20;">
                <i class="fa fa-lock text-warning me-1" aria-hidden="true"></i>
                <span>{{#str}}seekinglocked, mod_securevideo{{/str}}</span>
            </div>

            {{! Interactive Question Overlay - inside player container for seamless fullscreen }}
            <div id="secureVideoQuestionOverlay"
                 class="securevideo-question-overlay position-absolute top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center p-3"
                 style="z-index: 40; background-color: rgba(0, 0, 0, 0.78);">
                <div class="securevideo-question-card card shadow-lg border-0 bg-white text-dark rounded-3 overflow-hidden"
                     style="width: 100%; max-width: 660px; max-height: 90%; display: flex; flex-direction: column;">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2 px-3">
                        <span class="fw-semibold securevideo-q-title">
                            <i class="fa fa-question-circle me-2" aria-hidden="true"></i>Knowledge Check
                        </span>
                        <span class="badge bg-light text-primary securevideo-q-timecode">00:00</span>
                    </div>
                    <div class="card-body p-3 overflow-auto securevideo-q-body" style="flex: 1 1 auto;">
                        <div class="securevideo-q-loading text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading question...</span>
                            </div>
                        </div>
                        <div class="securevideo-q-content d-none">
                            {{! Injected Question Engine HTML }}
                        </div>
                        <div class="securevideo-q-feedback d-none mt-3">
                            {{! Injected Graded Feedback HTML }}
                        </div>
                    </div>
                    <div class="card-footer bg-light d-flex justify-content-between align-items-center py-2 px-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm securevideo-btn-retry d-none">
                            <i class="fa fa-rotate-left me-1" aria-hidden="true"></i>{{#str}}tryagain, mod_securevideo{{/str}}
                        </button>
                        <button type="button" class="btn btn-primary btn-sm ms-auto securevideo-btn-submit">
                            <i class="fa fa-check me-1" aria-hidden="true"></i>{{#str}}submitanswer, mod_securevideo{{/str}}
                        </button>
                        <button type="button" class="btn btn-success btn-sm ms-auto securevideo-btn-continue d-none">
                            <i class="fa fa-arrow-right me-1" aria-hidden="true"></i>{{#str}}continuevideo, mod_securevideo{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {{! Custom Controls Bar }}
        <div class="securevideo-controls-bar bg-dark bg-opacity-95 text-white p-2" style="z-index: 30;">
            {{! Scrubber / Timeline }}
            <div class="securevideo-timeline-wrapper position-relative py-1 cursor-pointer">
                <div class="securevideo-timeline-track bg-secondary rounded position-relative" style="height: 6px;">
                    <div class="securevideo-buffered-bar bg-light bg-opacity-25 rounded position-absolute top-0 start-0 h-100" style="width: 0%;"></div>
                    <div class="securevideo-progress-bar bg-primary rounded position-absolute top-0 start-0 h-100" style="width: 0%;"></div>
                    {{#preventseeking}}
                    <div class="securevideo-max-marker position-absolute top-0 h-100 bg-warning" style="width: 3px; left: 0%;" title="{{#str}}preventseeking, mod_securevideo{{/str}}"></div>
                    {{/preventseeking}}

                    {{! Interactive question cue markers on timeline }}
                    {{#questions}}
                    <div class="securevideo-cue-marker position-absolute top-50 rounded-circle border border-white {{#passed}}bg-success{{/passed}}{{^passed}}bg-info{{/passed}}"
                         data-cueid="{{id}}"
                         data-timecode="{{timecode}}"
                         style="left: {{percent}}%; width: 10px; height: 10px; transform: translate(-50%, -50%); z-index: 5;"
                         title="{{title}} ({{timeformatted}})"></div>
                    {{/questions}}
                </div>
            </div>

            {{! Button Row }}
            <div class="d-flex justify-content-between align-items-center mt-1">
                {{! Left: Play, Volume, Time }}
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-link text-white p-1 securevideo-btn-play" title="{{#str}}play, mod_securevideo{{/str}}">
                        <i class="fa fa-play" aria-hidden="true"></i>
                    </button>
                    <div class="d-flex align-items-center gap-1 securevideo-volume-group">
                        <button type="button" class="btn btn-link text-white p-1 securevideo-btn-mute" title="{{#str}}mute, mod_securevideo{{/str}}">
                            <i class="fa fa-volume-up" aria-hidden="true"></i>
                        </button>
                        <input type="range" class="form-range securevideo-volume-slider" min="0" max="1" step="0.05" value="1" style="width: 70px;">
                    </div>
                    <span class="small font-monospace text-white-50 ms-1">
                        <span class="securevideo-current-time text-white">00:00</span> / {{durationformatted}}
                    </span>
                </div>

                {{! Right: Speed, Quality, Fullscreen }}
                <div class="d-flex align-items-center gap-2">
                    {{! Playback Speed Dropup }}
                    <div class="dropup">
                        <button class="btn btn-sm btn-link text-white text-decoration-none p-1 dropdown-toggle securevideo-btn-speed"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                title="{{#str}}speed, mod_securevideo{{/str}}">
                            <span class="securevideo-current-speed">1x</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end securevideo-speed-menu">
                            <li><button class="dropdown-item" type="button" data-speed="0.75">0.75x</button></li>
                            <li><button class="dropdown-item active" type="button" data-speed="1.0">1x (Normal)</button></li>
                            <li><button class="dropdown-item" type="button" data-speed="1.25">1.25x</button></li>
                            <li><button class="dropdown-item" type="button" data-speed="1.5">1.5x</button></li>
                            <li><button class="dropdown-item" type="button" data-speed="2.0">2x</button></li>
                        </ul>
                    </div>

                    {{! Quality Dropup }}
                    <div class="dropup securevideo-quality-container d-none">
                        <button class="btn btn-sm btn-link text-white text-decoration-none p-1 dropdown-toggle securevideo-btn-quality"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                title="{{#str}}quality, mod_securevideo{{/str}}">
                            <i class="fa fa-cog me-1" aria-hidden="true"></i><span class="securevideo-current-quality">{{#str}}auto, mod_securevideo{{/str}}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end securevideo-quality-menu">
                            <li><button class="dropdown-item active" type="button" data-level="-1">{{#str}}auto, mod_securevideo{{/str}}</button></li>
                        </ul>
                    </div>

                    {{! Fullscreen Toggle }}
                    <button type="button" class="btn btn-link text-white p-1 securevideo-btn-fullscreen" title="{{#str}}fullscreen, mod_securevideo{{/str}}">
                        <i class="fa fa-expand" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {{! Watch progress bar & completion indicator }}
    <div class="d-flex justify-content-between align-items-center mt-2 px-1">
        <div class="small text-muted">
            {{#hascompletionrule}}
            {{#str}}watchprogress, mod_securevideo, { "percent": {{percentcompleted}}, "min": {{completionminpercent}} }{{/str}}
            {{/hascompletionrule}}
            {{^hascompletionrule}}
            {{#str}}watchprogress_no_min, mod_securevideo, {{percentcompleted}}{{/str}}
            {{/hascompletionrule}}
        </div>
        <div class="progress" style="width: 200px; height: 8px;">
            <div class="progress-bar bg-success"
                 role="progressbar"
                 style="width: {{percentcompleted}}%;"
                 aria-valuenow="{{percentcompleted}}"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>
        </div>
    </div>
</div>

{{#js}}
require(['mod_securevideo/player'], function(Player) {
    Player.init('secureVideoContainer');
});
{{/js}}
