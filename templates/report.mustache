{{!
    @template mod_securevideo/report

    Template for student watch progress report.

    Context variables required for this template:
    * instancename - Name of the activity instance.
    * videotitle - Linked video title.
    * durationformatted - Total duration formatted mm:ss.
    * totalenrolled - Count of enrolled students.
    * totalcompleted - Count of completed students.
    * avgpercent - Average watch percentage.
    * hasstudents - Boolean whether students exist.
    * students - Array of student records.
    * backurl - URL to return to player view.
    * completionminpercent - Required percentage or 0.
}}
<div class="mod-securevideo-report container-fluid px-0">
    <!-- Header banner -->
    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h3 class="mb-1 text-primary fw-bold">{{#str}}report_title, mod_securevideo{{/str}}</h3>
                <div class="text-muted d-flex flex-wrap align-items-center gap-3">
                    <span><i class="fa fa-film me-1 text-secondary" aria-hidden="true"></i><strong>{{videotitle}}</strong></span>
                    <span><i class="fa fa-clock-o me-1 text-secondary" aria-hidden="true"></i>{{durationformatted}}</span>
                    {{#completionminpercent}}
                    <span><i class="fa fa-check-square-o me-1 text-success" aria-hidden="true"></i>{{#str}}completionminpercent_desc, mod_securevideo, {{completionminpercent}}{{/str}}</span>
                    {{/completionminpercent}}
                </div>
            </div>
            <div>
                <a href="{{backurl}}" class="btn btn-outline-primary">
                    <i class="fa fa-arrow-left me-1" aria-hidden="true"></i>{{#str}}backtovideo, mod_securevideo{{/str}}
                </a>
            </div>
        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="fa fa-users fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">{{#str}}report_summary_total, mod_securevideo{{/str}}</div>
                        <h3 class="mb-0 fw-bold">{{totalenrolled}}</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="fa fa-check-circle fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">{{#str}}report_summary_completed, mod_securevideo{{/str}}</div>
                        <h3 class="mb-0 fw-bold text-success">{{totalcompleted}}</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-circle bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="fa fa-pie-chart fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">{{#str}}report_summary_avg, mod_securevideo{{/str}}</div>
                        <h3 class="mb-0 fw-bold text-info">{{avgpercent}}%</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Students progress table card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom">
            <h5 class="mb-0 fw-bold text-dark">{{#str}}modulenameplural, mod_securevideo{{/str}}</h5>
            <div style="min-width: 250px;">
                <input type="text" id="securevideo-report-filter" class="form-control form-control-sm" placeholder="{{#str}}searchvideos, mod_securevideo{{/str}}">
            </div>
        </div>
        <div class="card-body p-0">
            {{#hasstudents}}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="securevideo-report-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="min-width: 220px;">{{#str}}student, mod_securevideo{{/str}}</th>
                            <th scope="col" style="min-width: 180px;">{{#str}}percentcompleted, mod_securevideo{{/str}}</th>
                            <th scope="col" class="text-center">{{#str}}watchedtime, mod_securevideo{{/str}}</th>
                            <th scope="col" class="text-center">{{#str}}lastposition, mod_securevideo{{/str}}</th>
                            <th scope="col" class="text-center">{{#str}}status, mod_securevideo{{/str}}</th>
                            <th scope="col" class="text-end pe-4">{{#str}}timemodified, core{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#students}}
                        <tr class="student-row" data-search="{{userfullname}} {{useremail}}">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    {{{userpicture}}}
                                    <div>
                                        <a href="{{userprofileurl}}" class="fw-semibold text-dark text-decoration-none d-block">
                                            {{userfullname}}
                                        </a>
                                        <small class="text-muted">{{useremail}}</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 10px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: {{percent}}%;" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="small fw-bold text-nowrap" style="min-width: 40px;">{{percent}}%</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border font-monospace">{{watchedformatted}}</span>
                                <small class="text-muted d-block mt-1">/ {{durationformatted}}</small>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border font-monospace">{{lastposformatted}}</span>
                            </td>
                            <td class="text-center">
                                <span class="{{statusclass}} px-2 py-1">{{statustext}}</span>
                            </td>
                            <td class="text-end pe-4">
                                <small class="text-muted">{{lastupdated}}</small>
                            </td>
                        </tr>
                        {{/students}}
                    </tbody>
                </table>
            </div>
            {{/hasstudents}}
            {{^hasstudents}}
            <div class="p-4 text-center text-muted">
                <i class="fa fa-info-circle fa-2x mb-2 text-secondary" aria-hidden="true"></i>
                <p class="mb-0">{{#str}}nostudentsfound, mod_securevideo{{/str}}</p>
            </div>
            {{/hasstudents}}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('securevideo-report-filter');
    if (!searchInput) return;
    searchInput.addEventListener('input', function() {
        var query = this.value.toLowerCase().trim();
        var rows = document.querySelectorAll('#securevideo-report-table .student-row');
        rows.forEach(function(row) {
            var searchData = (row.getAttribute('data-search') || '').toLowerCase();
            if (query === '' || searchData.indexOf(query) !== -1) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });
});
</script>
