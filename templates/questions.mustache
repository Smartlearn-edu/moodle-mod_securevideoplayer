{{!
    @template mod_securevideo/questions

    Management page for in-video interactive questions and cuepoints.
}}
<div class="mod-securevideo-questions-container my-3" data-cmid="{{cmid}}" data-duration="{{duration}}">
    {{! Header & Actions }}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="mb-1">
                <i class="fa fa-question-circle text-primary me-2" aria-hidden="true"></i>{{#str}}managequestions, mod_securevideo{{/str}}
            </h3>
            <p class="text-muted mb-0">{{#str}}managequestions_desc, mod_securevideo{{/str}}</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{backtovideourl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-1" aria-hidden="true"></i>{{#str}}backtovideo, mod_securevideo{{/str}}
            </a>
            <button type="button" class="btn btn-primary btn-add-question" data-timecode="0">
                <i class="fa fa-plus me-1" aria-hidden="true"></i>{{#str}}addquestion, mod_securevideo{{/str}}
            </button>
        </div>
    </div>

    {{#hasmedia}}
    {{! Video Timeline Scrubber & Preview Card }}
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
            <span class="fw-semibold text-secondary">
                <i class="fa fa-video me-1" aria-hidden="true"></i>{{videoname}}
            </span>
            <span class="badge bg-secondary securevideo-preview-timer">00:00 / {{durationformatted}}</span>
        </div>
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <div class="col-md-5 col-lg-4">
                    <div class="ratio ratio-16x9 bg-black rounded overflow-hidden shadow-sm position-relative">
                        <video id="secureVideoPreviewElement"
                               class="w-100 h-100"
                               preload="metadata"
                               poster="{{thumbnailurl}}"
                               playsinline
                               controls>
                        </video>
                    </div>
                </div>
                <div class="col-md-7 col-lg-8">
                    <h5 class="card-title mb-2">Scrub to Timestamp</h5>
                    <p class="text-muted small mb-3">
                        Play or scrub the video to locate the exact moment where you want to ask a question, then click the button below.
                    </p>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="input-group" style="max-width: 200px;">
                            <span class="input-group-text"><i class="fa fa-clock" aria-hidden="true"></i></span>
                            <input type="text" id="secureVideoScrubTimeInput" class="form-control text-center fw-bold" value="00:00" readonly>
                        </div>
                        <button type="button" class="btn btn-success btn-add-at-current">
                            <i class="fa fa-plus-circle me-1" aria-hidden="true"></i>{{#str}}addquestion, mod_securevideo{{/str}}
                        </button>
                    </div>
                    <div class="small text-secondary">
                        <i class="fa fa-info-circle me-1" aria-hidden="true"></i>
                        {{#str}}questioncount, mod_securevideo, {{questioncount}}{{/str}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/hasmedia}}

    {{! Configured Questions List }}
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-list-check text-info me-2" aria-hidden="true"></i>{{#str}}interactivequestions, mod_securevideo{{/str}}
            </h5>
            <span class="badge bg-primary rounded-pill">{{questioncount}}</span>
        </div>
        <div class="card-body p-0">
            {{#hasquestions}}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 120px;">{{#str}}timecode, mod_securevideo{{/str}}</th>
                            <th>{{#str}}selectquestion, mod_securevideo{{/str}}</th>
                            <th style="width: 140px;">{{#str}}requirecorrect, mod_securevideo{{/str}}</th>
                            <th style="width: 140px;">{{#str}}rewindonfail, mod_securevideo{{/str}}</th>
                            <th style="width: 140px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#questions}}
                        <tr data-cueid="{{id}}" data-timecode="{{timecode}}" data-qid="{{questionid}}" data-qbeid="{{questionbankentryid}}" data-title="{{title}}" data-req="{{#requirecorrect}}1{{/requirecorrect}}{{^requirecorrect}}0{{/requirecorrect}}" data-rewind="{{rewindonfail}}">
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary btn-jump-to-time font-monospace" data-timecode="{{timecode}}" title="{{#str}}jumpto, mod_securevideo{{/str}} {{timeformatted}}">
                                    <i class="fa fa-play fa-xs me-1" aria-hidden="true"></i>{{timeformatted}}
                                </button>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">{{title}}</div>
                                <div class="small text-secondary d-flex align-items-center gap-2 mt-1">
                                    <span class="badge bg-light text-dark border">{{qtype}}</span>
                                    <span class="fw-medium text-truncate" style="max-width: 320px;">{{questionname}}</span>
                                </div>
                                {{#snippet}}
                                <div class="small text-muted mt-1 fst-italic">{{snippet}}</div>
                                {{/snippet}}
                            </td>
                            <td>
                                {{#requirecorrect}}
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="fa fa-check-circle me-1" aria-hidden="true"></i>Required
                                </span>
                                {{/requirecorrect}}
                                {{^requirecorrect}}
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                    Informational
                                </span>
                                {{/requirecorrect}}
                            </td>
                            <td>
                                {{#hasrewind}}
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                    <i class="fa fa-rotate-left me-1" aria-hidden="true"></i>{{rewindonfail}}s
                                </span>
                                {{/hasrewind}}
                                {{^hasrewind}}
                                <span class="badge bg-light text-muted border">No rewind</span>
                                {{/hasrewind}}
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary btn-edit-cue" title="{{#str}}editquestion, mod_securevideo{{/str}}">
                                        <i class="fa fa-pencil" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-delete-cue" title="{{#str}}deletequestion, mod_securevideo{{/str}}">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {{/questions}}
                    </tbody>
                </table>
            </div>
            {{/hasquestions}}
            {{^hasquestions}}
            <div class="text-center py-5">
                <i class="fa fa-question-circle fa-3x text-muted opacity-50 mb-3" aria-hidden="true"></i>
                <h6 class="text-secondary fw-normal">{{#str}}noquestionsconfigured, mod_securevideo{{/str}}</h6>
                <button type="button" class="btn btn-primary btn-sm mt-2 btn-add-question" data-timecode="0">
                    <i class="fa fa-plus me-1" aria-hidden="true"></i>{{#str}}addquestion, mod_securevideo{{/str}}
                </button>
            </div>
            {{/hasquestions}}
        </div>
    </div>

    {{! Add / Edit Question Modal }}
    <div class="modal fade" id="secureVideoAddQuestionModal" tabindex="-1" aria-labelledby="secureVideoAddQuestionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="secureVideoAddQuestionModalLabel">
                        <i class="fa fa-question-circle me-2" aria-hidden="true"></i><span class="modal-title-text">{{#str}}addquestion, mod_securevideo{{/str}}</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="secureVideoCueForm">
                        <input type="hidden" id="cueId" value="0">
                        <input type="hidden" id="cueQbeId" value="0">

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label for="cueTimecode" class="form-label fw-semibold">
                                    {{#str}}timecode, mod_securevideo{{/str}} <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa fa-clock" aria-hidden="true"></i></span>
                                    <input type="text" id="cueTimecode" class="form-control" placeholder="01:30 or 90" required>
                                </div>
                                <div class="form-text small">{{#str}}timecode_help, mod_securevideo{{/str}}</div>
                            </div>
                            <div class="col-sm-6">
                                <label for="cueTitle" class="form-label fw-semibold">
                                    {{#str}}questiontitle, mod_securevideo{{/str}}
                                </label>
                                <input type="text" id="cueTitle" class="form-control" placeholder="{{#str}}questiontitle_default, mod_securevideo{{/str}}">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="cueCategorySelect" class="form-label fw-semibold">
                                {{#str}}questioncategory, mod_securevideo{{/str}} <span class="text-danger">*</span>
                            </label>
                            <select id="cueCategorySelect" class="form-select" required>
                                <option value="">{{#str}}choosecategory, mod_securevideo{{/str}}</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="cueQuestionSelect" class="form-label fw-semibold">
                                {{#str}}selectquestion, mod_securevideo{{/str}} <span class="text-danger">*</span>
                            </label>
                            <select id="cueQuestionSelect" class="form-select" disabled required>
                                <option value="">{{#str}}choosequestion, mod_securevideo{{/str}}</option>
                            </select>
                        </div>

                        {{! Question Preview Box }}
                        <div id="cueQuestionPreviewBox" class="alert alert-secondary d-none p-3 mb-3">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-secondary" id="previewQtype"></span>
                                <strong id="previewQname"></strong>
                            </div>
                            <div id="previewQtext" class="small text-muted fst-italic"></div>
                        </div>

                        <hr class="my-3">

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="cueRequireCorrect" checked>
                                    <label class="form-check-label fw-semibold" for="cueRequireCorrect">
                                        {{#str}}requirecorrect, mod_securevideo{{/str}}
                                    </label>
                                </div>
                                <div class="form-text small">{{#str}}requirecorrect_help, mod_securevideo{{/str}}</div>
                            </div>
                            <div class="col-sm-6">
                                <label for="cueRewindOnFail" class="form-label fw-semibold">
                                    {{#str}}rewindonfail, mod_securevideo{{/str}}
                                </label>
                                <select id="cueRewindOnFail" class="form-select">
                                    <option value="0">{{#str}}rewind_none, mod_securevideo{{/str}}</option>
                                    <option value="10">10 seconds</option>
                                    <option value="15" selected>15 seconds</option>
                                    <option value="30">30 seconds</option>
                                    <option value="60">60 seconds</option>
                                </select>
                                <div class="form-text small">{{#str}}rewindonfail_help, mod_securevideo{{/str}}</div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-save-cue">
                        <i class="fa fa-save me-1" aria-hidden="true"></i>{{#str}}savecuepoint, mod_securevideo{{/str}}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
